# Browser-visible configuration. Use the API gateway origin, never a service URL.
# Local development can leave this unset and use Vite's /api proxy.
VITE_API_URL=http://localhost:5100/api

# Optional separate Socket.IO origin. Defaults to the API origin/current origin.
VITE_SOCKET_URL=http://localhost:5100

# Optional Vite dev proxy target. Not used in production builds.
VITE_API_PROXY_TARGET=http://localhost:5100
