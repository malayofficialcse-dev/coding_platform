# Local development uses localhost service ports. Render should set APP_ENV=production
# and provide the standard *_SERVICE_URL variables in the gateway's Environment tab.
APP_ENV=local
AUTH_SERVICE_URL=http://localhost:5001
USER_SERVICE_URL=http://localhost:5002
POST_SERVICE_URL=http://localhost:5003
EXAM_SERVICE_URL=http://localhost:5004
COURSE_SERVICE_URL=http://localhost:5005
ENROLLMENT_SERVICE_URL=http://localhost:5006
CODING_SERVICE_URL=http://localhost:5007
NOTIFICATION_SERVICE_URL=http://localhost:5008
CHAT_SERVICE_URL=http://localhost:5009
MENTOR_SERVICE_URL=http://localhost:5010
AI_SERVICE_URL=http://localhost:5011
