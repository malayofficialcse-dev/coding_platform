# ================================================
# Code Campus AI Service — Environment Variables
# ================================================
# Copy this file to .env and fill in your real values.
# NEVER commit real credentials to source control.
# ================================================

PORT=5011

# --- OpenAI / Groq ---
# Replace with your actual Groq or OpenAI API key
OPENAI_API_KEY=your-groq-or-openai-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b
OPENAI_EMBEDDING_MODEL=fastembed

# --- LangSmith Observability (optional — set to false to disable) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=code-campus-ai
# Leave blank or set a valid LangSmith key to enable tracing
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Vector Store ---
VECTOR_STORE=pinecone
PINECONE_INDEX_NAME=code-campus-knowledge
# Set your Pinecone API key here
PINECONE_API_KEY=your-pinecone-api-key-here

# ChromaDB (local fallback only — not used in production)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=code_campus_knowledge

# --- MongoDB (Atlas cloud URIs) ---
# Set to your MongoDB Atlas connection strings
COURSE_MONGO_URI=
CODING_MONGO_URI=

# --- PostgreSQL (Neon cloud pooled URLs) ---
# Set to your Neon pooled connection strings for each schema
USER_DATABASE_URL=
AUTH_DATABASE_URL=
EXAM_DATABASE_URL=
ENROLLMENT_DATABASE_URL=
CODING_DATABASE_URL=

# --- Internal service URLs (update for production hostnames) ---
USER_SERVICE_URL=http://localhost:5002
ENROLLMENT_SERVICE_URL=http://localhost:5006
INTERNAL_SERVICE_TOKEN=

# --- JWT (same secret as other services) ---
JWT_SECRET=

# --- CORS ---
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
AI_RATE_LIMIT_PER_MINUTE=20

